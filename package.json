{
  "name": "auramusic-simpmusic",
  "private": true,
  "version": "1.0.0",
  "description": "Cross-Platform Open-Source Music Streaming App powered by YouTube Music InnerTube, SponsorBlock, ReturnYouTubeDislike & LRCLIB",
  "type": "module",
  "scripts": {
    "start": "node --openssl-legacy-provider server/index.js",
    "dev:server": "node --openssl-legacy-provider server/index.js",
    "dev:client": "vite --host 0.0.0.0 --port 5173",
    "dev": "npm run build && node --openssl-legacy-provider server/index.js",
    "build": "vite build"
  },
  "dependencies": {
    "express": "^4.19.2",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.5.3",
    "vite": "^5.4.8"
  }
}
